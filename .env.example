# ---------- App ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Number of reverse-proxy hops to trust for req.ip (used by the login rate limit)
TRUST_PROXY=1
# Comma separated list, or * for any origin
CORS_ORIGINS=*
SWAGGER_ENABLED=true

# ---------- Datastores ----------
MONGO_URI=mongodb://localhost:27017/splitease
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ---------- Auth (secrets must be >= 32 chars and different) ----------
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-0123456789
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_SALT_ROUNDS=10
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Balances ----------
BALANCE_CACHE_TTL_SECONDS=86400
# If a cached balance is stale for longer than this, the API recomputes it synchronously
BALANCE_STALE_RECOMPUTE_SECONDS=60

# ---------- Email (Mailpit) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="SplitEase <no-reply@splitease.local>"

# ---------- Background processing ----------
EXPORT_DIR=./exports
WORKER_POOL_SIZE=2
WORKER_TASK_TIMEOUT_MS=60000
RABBITMQ_PREFETCH=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
